# Database Configuration
# Option 1: Use individual DB_* variables
DB_NAME=sungrip_db
DB_USER=sungrip_user
DB_PASSWORD=change_this_password
DB_HOST=db
DB_PORT=5432
# Option 2: Use a single DATABASE_URL (takes precedence over individual DB_* variables)
# DATABASE_URL=postgres://sungrip_user:change_this_password@db:5432/sungrip_db

# Redis Configuration
REDIS_PASSWORD=change_this_redis_password
CELERY_BROKER_URL=redis://:change_this_redis_password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:change_this_redis_password@redis:6379/0
# Channel layer Redis URL (auto-constructed from REDIS_PASSWORD if omitted)
# REDIS_URL=redis://:change_this_redis_password@redis:6379/1

# Django Configuration
SECRET_KEY=change_this_secret_key_to_something_very_secure
DEBUG=True
ALLOWED_HOSTS=api.zimgrow.shop,localhost,127.0.0.1,backend
DJANGO_PORT=8000

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://zimgrow.shop,http://localhost:3000,http://localhost:80

# CSRF Configuration (required for Django admin behind HTTPS reverse proxy)
CSRF_TRUSTED_ORIGINS=https://api.zimgrow.shop,https://zimgrow.shop

# WhatsApp Business API Configuration
WHATSAPP_API_VERSION=v18.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_APP_SECRET=your_app_secret
WHATSAPP_VERIFY_TOKEN=sungrip_verify_token_change_this

# Google Gemini AI Configuration (Optional)
GOOGLE_AI_API_KEY=your_google_ai_api_key

# Email Configuration (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_password
EMAIL_USE_TLS=True

# Payment Gateway Configuration (Optional)
PAYNOW_INTEGRATION_ID=your_paynow_integration_id
PAYNOW_INTEGRATION_KEY=your_paynow_integration_key

# Application URLs
FRONTEND_URL=https://zimgrow.shop
BACKEND_URL=https://api.zimgrow.shop/api
